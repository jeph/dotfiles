{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/slowpoke.png",
    "width": 30,
    "height": 15,
    "padding": {
      "right": 3
    }
  },
  "display": {
    "color": {
      "keys": "#89b4fa",
      "title": "#cba6f7",
      "output": "#cdd6f4",
      "separator": "#6c7086"
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "#a6e3a1",
        "yellow": "#f9e2af",
        "red": "#f38ba8"
      }
    },
    "bar": {
      "width": 10,
      "color": {
        "total": "#585b70"
      },
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "border": {
        "left": "",
        "right": ""
      }
    }, 
    "size": {
      "binaryPrefix": "jedec"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "uptime",
    "shell",
    "de",
    "icons",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
